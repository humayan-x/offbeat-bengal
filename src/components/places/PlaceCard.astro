---
import type { Place } from '../../types/place';
import { IconArrowUpRight, IconAntenna } from '@tabler/icons-astro';

interface Props {
  place: Place;
}

const { place } = Astro.props;

const isSignalGood = place.network.jio.toLowerCase() === 'good' || place.network.airtel.toLowerCase() === 'good';
---

<a 
  href={`/${place.district}/${place.slug}`}
  class="group flex min-w-0 flex-col justify-between rounded border border-[#e5e0d8] bg-white p-4.5 hover:border-[#b45309]/50 hover:shadow-xs transition duration-200 relative overflow-hidden"
>
  <!-- Subtle top index line -->
  <div class="space-y-3">
    <div class="flex items-start justify-between gap-2 text-xs border-b border-[#f2efe9] pb-2.5">
      <span class="font-mono text-[10px] uppercase tracking-wider font-semibold text-[#2d4739] bg-[#2d4739]/10 px-2 py-0.5 rounded break-words">
        {place.category}
      </span>
      <span class="font-mono text-[11px] text-[#4a5550] flex items-center gap-1">
        <span class="text-[#7d8a83]">EL.</span>
        <strong class="font-semibold text-[#1c2421]">{place.altitudeFeet.toLocaleString()}</strong> ft
      </span>
    </div>

    <div>
      <h3 class="font-serif text-lg font-medium text-[#1c2421] group-hover:text-[#b45309] transition leading-snug">
        {place.title}
      </h3>
      <p class="text-xs text-[#5f6c65] mt-1.5 line-clamp-2 leading-relaxed font-sans">
        {place.usp}
      </p>
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-[#f2efe9] flex items-center justify-between gap-2 text-xs font-mono text-[#7d8a83]">
    <div class="min-w-0 flex items-center gap-1.5 text-[11px]">
      <span>{place.nearestHub.distanceKm} km drive</span>
    </div>
    <span class="inline-flex shrink-0 items-center gap-0.5 text-[11px] text-[#1c2421] font-semibold group-hover:text-[#b45309] transition">
      Spec Sheet <IconArrowUpRight class="size-3 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition" />
    </span>
  </div>
</a>
