---
import { IconAntenna, IconMountain, IconCompass, IconCheck } from '@tabler/icons-astro';
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-b border-[#e5e0d8]">
  <div class="max-w-xl mx-auto text-center mb-10 space-y-2">
    <div class="font-mono text-[10px] uppercase tracking-widest text-[#b45309] font-semibold">
      PRACTICAL EXPEDITION METRICS
    </div>
    <h2 class="font-serif text-2xl sm:text-3xl font-medium text-[#1c2421]">Calibrated for Mountain Silence</h2>
    <p class="text-xs sm:text-sm text-[#5f6c65] font-sans">Zero sponsored promotional blurbs. Only verified travel specifications.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <div class="rounded border border-[#e5e0d8] bg-white p-6 space-y-3.5 shadow-2xs">
      <div class="size-9 rounded bg-[#f2efe9] flex items-center justify-center text-[#2d4739] border border-[#e5e0d8]">
        <IconAntenna class="size-4.5" />
      </div>
      <div>
        <h3 class="font-serif text-lg font-medium text-[#1c2421]">Field-Tested Cellular Signal</h3>
        <p class="text-xs text-[#5f6c65] mt-1 leading-relaxed font-sans">
          Whether working remotely from a homestay balcony or needing emergency connectivity, each spot records field-checked Jio and Airtel 4G/5G edge stability.
        </p>
      </div>
      <div class="font-mono text-[11px] text-[#7d8a83] pt-2 border-t border-[#f2efe9] flex items-center gap-1">
        <IconCheck class="size-3 text-[#2d4739]" /> Verified coverage grades
      </div>
    </div>

    <div class="rounded border border-[#e5e0d8] bg-white p-6 space-y-3.5 shadow-2xs">
      <div class="size-9 rounded bg-[#f2efe9] flex items-center justify-center text-[#2d4739] border border-[#e5e0d8]">
        <IconMountain class="size-4.5" />
      </div>
      <div>
        <h3 class="font-serif text-lg font-medium text-[#1c2421]">Calibrated Altitudes</h3>
        <p class="text-xs text-[#5f6c65] mt-1 leading-relaxed font-sans">
          Accurate elevations in feet so you can pack accurately — from misty 3,200 ft river valleys up to freezing 8,500 ft high-ridge viewpoints.
        </p>
      </div>
      <div class="font-mono text-[11px] text-[#7d8a83] pt-2 border-t border-[#f2efe9] flex items-center gap-1">
        <IconCheck class="size-3 text-[#2d4739]" /> Topographic contour data
      </div>
    </div>

    <div class="rounded border border-[#e5e0d8] bg-white p-6 space-y-3.5 shadow-2xs">
      <div class="size-9 rounded bg-[#f2efe9] flex items-center justify-center text-[#2d4739] border border-[#e5e0d8]">
        <IconCompass class="size-4.5" />
      </div>
      <div>
        <h3 class="font-serif text-lg font-medium text-[#1c2421]">Direct Transit Hub Routing</h3>
        <p class="text-xs text-[#5f6c65] mt-1 leading-relaxed font-sans">
          Straightforward road kilometers and shared jeep routes from NJP railway station and Bagdogra airport, avoiding syndicate markups.
        </p>
      </div>
      <div class="font-mono text-[11px] text-[#7d8a83] pt-2 border-t border-[#f2efe9] flex items-center gap-1">
        <IconCheck class="size-3 text-[#2d4739]" /> Calibrated road distance
      </div>
    </div>
  </div>
</section>