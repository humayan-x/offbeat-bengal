---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEOHead from '../../components/layout/SEOHead.astro';
import PlaceHero from '../../components/places/PlaceHero.astro';
import QuickStats from '../../components/places/QuickStats.astro';
import NetworkCoverage from '../../components/places/NetworkCoverage.astro';
import PlaceCard from '../../components/places/PlaceCard.astro';

import darjeelingData from '../../data/darjeeling.json';
import kalimpongData from '../../data/kalimpong.json';
import type { Place } from '../../types/place';
import { IconArrowLeft, IconMapPin2, IconExternalLink, IconCompass } from '@tabler/icons-astro';

export function getStaticPaths() {
  const allPlaces: Place[] = [
    ...(darjeelingData as Place[]),
    ...(kalimpongData as Place[]),
  ];

  return allPlaces.map((place) => {
    const nearby = allPlaces
      .filter((p) => p.district === place.district && p.slug !== place.slug)
      .slice(0, 3);

    return {
      params: { district: place.district, slug: place.slug },
      props: {
        place,
        nearby,
        districtPlaceCount: allPlaces.filter((item) => item.district === place.district).length,
      },
    };
  });
}

interface Props {
  place: Place;
  nearby: Place[];
  districtPlaceCount: number;
}

const { place, nearby, districtPlaceCount } = Astro.props;
const formattedDistrict = place.district.charAt(0).toUpperCase() + place.district.slice(1);
---

<BaseLayout>
  <SEOHead slot="head" place={place} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    <!-- Breadcrumb / Back Bar -->
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-2 gap-y-1.5 font-mono text-xs text-[#7d8a83]">
      <a
        href={`/places/${place.district}`}
        class="inline-flex items-center gap-1.5 hover:text-[#1c2421] transition"
      >
        <IconArrowLeft class="size-3.5" />
        <span>All {formattedDistrict} Hamlets</span>
      </a>
      <span>/</span>
      <span class="text-[#1c2421] font-medium break-words">{place.title}</span>
    </nav>

    <!-- Main Detail Section -->
    <article class="space-y-8">
      <PlaceHero place={place} />

      <QuickStats place={place} />

      <section class="rounded border border-[#e5e0d8] bg-white p-5 sm:p-6 shadow-2xs">
        <div class="font-mono text-[10px] uppercase tracking-widest text-[#7d8a83]">PLACE NOTES</div>
        <h2 class="font-serif text-2xl font-medium text-[#1c2421] mt-1">What {place.title} feels like</h2>
        <p class="mt-3 text-sm leading-7 text-[#4a5550]">{place.about}</p>
      </section>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Cellular Network Coverage Card -->
        <NetworkCoverage network={place.network} />

        <!-- Coordinates & Cartographic Directions Card -->
        <div class="rounded border border-[#e5e0d8] bg-white p-5 shadow-2xs flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-2 text-[#1c2421] font-mono text-[10px] uppercase tracking-wider font-semibold">
              <IconMapPin2 class="size-4 text-[#b45309]" />
              <span>Cartography & Routing</span>
            </div>
            <p class="text-xs text-[#4a5550] leading-relaxed font-sans">
              Contour Coordinates: <span class="font-mono text-[#1c2421] font-semibold">{place.geo.lat}° N, {place.geo.lng}° E</span>
            </p>
            <p class="font-mono text-xs text-[#7d8a83] mt-1.5">
              {place.nearestHub.distanceKm} km transit drive from {place.nearestHub.name}.
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-[#f2efe9]">
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${place.geo.lat},${place.geo.lng}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 rounded border border-[#e5e0d8] bg-[#f9f8f5] hover:bg-[#f2efe9] text-xs font-mono font-medium text-[#1c2421] transition shadow-2xs"
            >
              <span>Satellite & Topographic Map</span>
              <IconExternalLink class="size-3.5 text-[#7d8a83]" />
            </a>
          </div>
        </div>
      </div>

      <section class="rounded border border-[#e5e0d8] bg-[#f9f8f5] p-5 sm:p-6">
        <div class="font-mono text-[10px] uppercase tracking-widest text-[#7d8a83]">LOCAL TABLE &amp; TOTE</div>
        <h2 class="font-serif text-2xl font-medium text-[#1c2421] mt-1">Eat and take home</h2>
        <div class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wide text-[#b45309]">Look for on the table</h3>
            <ul class="mt-2 space-y-1.5 text-sm leading-6 text-[#4a5550]">
              {place.foodAndShopping.eat.map((item) => <li>• {item}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wide text-[#b45309]">Good small buys</h3>
            <ul class="mt-2 space-y-1.5 text-sm leading-6 text-[#4a5550]">
              {place.foodAndShopping.buy.map((item) => <li>• {item}</li>)}
            </ul>
          </div>
        </div>
        <p class="mt-5 border-t border-[#e5e0d8] pt-4 text-xs leading-5 text-[#7d8a83]">{place.foodAndShopping.note}</p>
      </section>

      <section class="space-y-5">
        <div>
          <div class="font-mono text-[10px] uppercase tracking-widest text-[#7d8a83]">PRACTICAL FAQ</div>
          <h2 class="font-serif text-2xl font-medium text-[#1c2421] mt-1">Before you go</h2>
        </div>
        <div class="grid grid-cols-1 items-start gap-4 md:grid-cols-2">
          {place.faqs.map((faq) => (
            <details class="group rounded border border-[#e5e0d8] bg-white p-5 shadow-2xs">
              <summary class="cursor-pointer list-none pr-6 font-serif text-lg font-medium text-[#1c2421] marker:content-none">
                {faq.question}
                <span class="float-right font-sans text-[#b45309] group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="mt-3 text-sm leading-6 text-[#4a5550]">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </article>

    <!-- Nearby Hamlets in Same District -->
    {nearby.length > 0 && (
      <section class="border-t border-[#e5e0d8] pt-10 space-y-5">
        <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div class="font-mono text-[10px] uppercase tracking-widest text-[#7d8a83]">
              ADJACENT HAMLETS
            </div>
            <h2 class="font-serif text-xl sm:text-2xl font-medium text-[#1c2421] mt-0.5">
              More Quiet Spots in {formattedDistrict}
            </h2>
          </div>
          <a
            href={`/places/${place.district}`}
            class="inline-flex min-h-11 items-center font-mono text-xs text-[#7d8a83] hover:text-[#b45309] transition sm:min-h-0"
          >
            View all {districtPlaceCount} spots &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {nearby.map((item) => (
            <PlaceCard place={item} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
